    # Knows(John, x) and Knows(y, Bill)
    expr1 = ['Knows', 'John', 'x']
    expr2 = ['Knows', 'y', 'Bill']
    print(f"Test 1: {expr1} & {expr2}")
    print("Result:", unify(expr1, expr2), "\n")

    # Test 2: Unification with nested functions
    # Knows(John, x) and Knows(y, Mother(y))
    expr3 = ['Knows', 'John', 'x']
    expr4 = ['Knows', 'y', ['Mother', 'y']]
    print(f"Test 2: {expr3} & {expr4}")
    print("Result:", unify(expr3, expr4), "\n")

    # Test 3: Occurs Check Failure (x cannot equal Mother(x))
    # Knows(x, x) and Knows(y, Mother(y))
    expr5 = ['Knows', 'x', 'x']
    expr6 = ['Knows', 'y', ['Mother', 'y']]
    print(f"Test 3 (Occurs Check): {expr5} & {expr6}")
    print("Result:", unify(expr5, expr6), "\n")

    # Test 4: Predicate Mismatch Failure
    # Likes(John, x) and Hates(John, Apple)
    expr7 = ['Likes', 'John', 'x']
    expr8 = ['Hates', 'John', 'Apple']
    print(f"Test 4 (Predicate Mismatch): {expr7} & {expr8}")
    print("Result:", unify(expr7, expr8), "\n")

    # Test 5: Complex nested unification
    # P(a, g(x, a), f(y)) and P(z, g(f(z), a), z)
    expr9 = ['P', 'a', ['g', 'x', 'a'], ['f', 'y']]
    expr10 = ['P', 'z', ['g', ['f', 'z'], 'a'], 'z']
    print(f"Test 5 (Complex): {expr9} & {expr10}")
    print("Result:", unify(expr9, expr10))






