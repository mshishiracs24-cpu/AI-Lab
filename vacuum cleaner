# Define the Vacuum Cleaner Agent Function
def vacuum_agent(room_a_status, room_b_status, initial_position):
    # Initialize the state of the environment
    rooms = {
        'A': room_a_status.upper(),
        'B': room_b_status.upper()
    }
    current_pos = initial_position.upper()
    actions_taken = []
    
    # Flag to control the loop execution (simulating the program flow)
    running = True
    
    while running:
        # Step 1: Check status of the current room
        if rooms[current_pos] == 'DIRTY':
            rooms[current_pos] = 'CLEAN'
            actions_taken.append("SUCK")
        
        # Step 2: Determine next move based on position
        if current_pos == 'A':
            # If A is clean but B might need checking, move right
            if rooms['B'] == 'DIRTY':
                current_pos = 'B'
                actions_taken.append("MOVE RIGHT")
            else:
                running = False  # Both are clean, stop
        
        elif current_pos == 'B':
            # If B is clean but A might need checking, move left
            if rooms['A'] == 'DIRTY':
                current_pos = 'A'
                actions_taken.append("MOVE LEFT")
            else:
                running = False  # Both are clean, stop
                
    # If no actions were required at all
    if not actions_taken:
        actions_str = "No cleaning required"
    else:
        actions_str = " → ".join(actions_taken)
        
    final_state = f"A={rooms['A']}, B={rooms['B']}"
    return actions_str, final_state

